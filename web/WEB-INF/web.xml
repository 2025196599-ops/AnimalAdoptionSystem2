<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>AnimalAdoptionSystem</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- AUTH FILTER -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.ariniqo.filter.AuthFilter</filter-class>
    </filter>

    <!-- Protect USER pages (WEB PAGES/User) -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/user/*</url-pattern>
    </filter-mapping>

    <!-- Protect ADMIN pages (WEB PAGES/admin) -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!-- Protect lost & found report servlets -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/reports/*</url-pattern>
    </filter-mapping>

    <!-- Protect adoption submit servlet -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/adopt</url-pattern>
    </filter-mapping>

    <!-- Protect article submission servlet -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/articles/submit</url-pattern>
    </filter-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Friendly error pages (avoid default server error screen) -->
    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/error.jsp</location>
    </error-page>

</web-app>
